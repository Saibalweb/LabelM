VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Trial mode: disables email-dependent auth flows (magic link, forgot password,
# team/invite management) so the app ships without SMTP. Set to false once
# Supabase SMTP is configured at final delivery.
VITE_TRIAL_MODE=false