# Local Edge Function env for `supabase functions serve` (auto-loaded).
#
# For hosted projects these are NOT read from this file — set them as Supabase
# secrets instead (Dashboard -> Edge Functions -> Secrets, or):
#   supabase secrets set --env-file supabase/functions/.env --project-ref <ref>
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are auto-injected
# by the platform — never set them here.

# Comma-separated list of browser origins allowed to call the functions.
# Use scheme + host only, NO trailing slash (the code strips one anyway).
# Prod example: https://labelm.saibal.dev
ALLOWED_ORIGINS=http://localhost:5173

# Fallback app origin used when a request has no Origin header (e.g. server-side
# calls). Also the app URL that invite links should point at. No trailing slash.
APP_URL=http://localhost:5173
